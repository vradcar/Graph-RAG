# Optional LLM provider settings
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Neo4j (optional if using local networkx graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password

# Groq LLM API
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter LLM API (alternative to Groq — use --inferencer openrouter)
# Default model: google/gemma-3-27b-it:free
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_SITE_URL=                # optional — shown on openrouter.ai rankings
OPENROUTER_SITE_NAME=GraphRAG       # optional

# Neo4j (only needed if overriding the default Docker password in settings.yaml)
NEO4J_PASSWORD=password
