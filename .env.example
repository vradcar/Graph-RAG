# Copy to .env and fill in your own values:
#     cp .env.example .env
# WARNING: that command OVERWRITES an existing .env. If you already have a
# working .env, back it up first or edit it by hand instead.

# LLM provider (locked to groq for this project)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Neo4j connection
#   Local Docker:  bolt://localhost:7687
#   Neo4j Aura:    neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687

# IMPORTANT: the code reads NEO4J_USER. NEO4J_USERNAME is NOT read anywhere —
# setting only that one makes every script fall back to a hardcoded "neo4j".
#   Local Docker:  neo4j
#   Neo4j Aura:    your instance ID (e.g. 3b68cef5), NOT "neo4j" — it's in the
#                  Neo4j-<id>-Created-<date>.txt file Aura downloads on setup.
NEO4J_USER=neo4j

NEO4J_PASSWORD=your_neo4j_password_here
